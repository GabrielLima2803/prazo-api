# Copie para .env e preencha. NUNCA commite o .env.
# Para carregar no shell:  set -a; . ./.env; set +a
# Valores com espaço ou & (como a URL do iCal) precisam de aspas simples.

# URL de exportação do calendário do Moodle (Calendário → Exportar calendário).
# CONTÉM O SEU authtoken: trate como senha. Use aspas simples: PRAZO_ICAL_URL='https://...'
PRAZO_ICAL_URL=

# Endereço do Moodle (sem barra no final). Se vazio, usa o host do iCal.
# Cada centro da UDESC tem o seu:
#   CCT Joinville: https://moodle.joinville.udesc.br
#   geral:         https://www.moodle.udesc.br
PRAZO_MOODLE_URL=https://moodle.joinville.udesc.br

# Token de web service do Moodle (opcional; Fase 5). Segredo.
PRAZO_MOODLE_TOKEN=

# Google Agenda (Fase 2) ------------------------------------------------------
# Caminho do JSON da credencial OAuth "App para computador" (Google Cloud Console).
PRAZO_GOOGLE_CREDENTIALS=secrets/google-oauth.json
# Nome da agenda dedicada que o Prazo cria e mantém.
PRAZO_CALENDAR_NAME='Prazo — UDESC'

# Chave que cifra os segredos guardados em disco (AES-256-GCM, 32 bytes em base64).
# Gere com: prazo keygen. Trocar a chave exige rodar "prazo auth" de novo.
PRAZO_MASTER_KEY=
# Onde ficam o token do Google (cifrado) e o estado. No Docker: /data.
PRAZO_DATA_DIR=data

# Sincroniza tudo o que o Moodle exporta (o semestre inteiro). Para cortar
# prazos antigos, informe uma data AAAA-MM-DD.
PRAZO_SYNC_SINCE=

# Filtros (opcionais). Siglas ou shortnames separados por vírgula.
PRAZO_IGNORE_COURSES=
# Tipos: assign, quiz, forum, exam, course_event, other
PRAZO_IGNORE_TYPES=
# Regex (sintaxe Go/RE2) aplicada ao título da atividade. Ex.: (?i)opcional|extra
PRAZO_IGNORE_TITLE_REGEX=
# Manter também o evento de abertura ("Início de X") quando existe o Término.
PRAZO_INCLUDE_OPENINGS=false

# API do app (prazo serve) --------------------------------------------------
# Token que o app usa para acessar a API (32+ caracteres; gere com prazo keygen). Segredo.
PRAZO_API_TOKEN=
# 127.0.0.1:8080 só aceita o próprio computador; 0.0.0.0:8080 libera o celular na rede local.
PRAZO_HTTP_ADDR=127.0.0.1:8080
# Endereço HTTPS público do servidor (ex.: Tailscale Funnel). Ativa o botão
# "Conectar Google" no app e permite usar o app fora de casa.
PRAZO_PUBLIC_URL=
# JSON da credencial OAuth "Aplicativo da Web", com o redirecionamento
# <PRAZO_PUBLIC_URL>/oauth/google/callback cadastrado no Google Cloud.
PRAZO_GOOGLE_WEB_CREDENTIALS=secrets/google-oauth-web.json
# Origens liberadas para o app rodando no navegador (Expo web), separadas por
# vírgula. Só para desenvolvimento: deixe vazio em produção (o app nativo não
# precisa de CORS). Ex.: http://localhost:8081
PRAZO_CORS_ORIGINS=

# LGPD: quem responde pelos dados e o e-mail para pedidos dos usuários.
# Aparecem na página pública /privacidade (exigida também pelo Google e pelas lojas).
PRAZO_PRIVACY_OPERATOR=
PRAZO_PRIVACY_CONTACT=

# Intervalo entre sincronizações automáticas (mínimo 1m).
PRAZO_SYNC_INTERVAL=30m

# Fuso da exibição e dos eventos na agenda (internamente tudo é UTC).
PRAZO_TIMEZONE=America/Sao_Paulo

# Logs: "text" (dev) ou "json" (produção). Nível: debug, info, warn, error.
PRAZO_LOG_FORMAT=text
PRAZO_LOG_LEVEL=info
