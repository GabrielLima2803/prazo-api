# Copie para .env e preencha. NUNCA commite o .env.
# Para carregar no shell:  set -a; . ./.env; set +a

# URL de exportação do calendário do Moodle (Calendário → Exportar calendário).
# CONTÉM O SEU authtoken: trate como senha.
PRAZO_ICAL_URL=

# Endereço do Moodle (sem barra no final).
PRAZO_MOODLE_URL=https://www.moodle.udesc.br

# Token de web service do Moodle (opcional; Fase 5). Segredo.
PRAZO_MOODLE_TOKEN=

# Logs: "text" (dev) ou "json" (produção). Nível: debug, info, warn, error.
PRAZO_LOG_FORMAT=text
PRAZO_LOG_LEVEL=info
